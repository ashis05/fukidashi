# Copy to .env and fill in. Never commit .env.

# --- server ---
HOST=127.0.0.1
PORT=8000
# Reject uploads larger than this (HTTP 413)
MAX_UPLOAD_MB=10
# Per-client request limit, "N/second|minute|hour"; 0/minute disables
RATE_LIMIT=30/minute
# Extra CORS origins, comma separated (chrome-extension://* is always allowed)
ALLOWED_ORIGINS=
# Load models at startup (1) instead of on the first request
WARMUP=0

# --- detection ---
DETECT_THRESHOLD=0.4

# --- translation ---
# google | gemini. Default: gemini if GEMINI_API_KEY is set, else google
TRANSLATOR=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# seconds
GEMINI_TIMEOUT=30

# --- rendering ---
# Path to a .ttf/.otf used by the CLI renderer (auto-detected if empty)
FUKIDASHI_FONT=
